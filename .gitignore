# CodeIgniter 4 .gitignore
.env

# Temporary / writable files
writable/cache/*
!writable/cache/index.html
writable/debugbar/*
!writable/debugbar/index.html
writable/logs/*
!writable/logs/index.html
writable/session/*
!writable/session/index.html
writable/uploads/*
!writable/uploads/index.html

# Composer
/vendor/

# IDE & OS files
.idea/
.vscode/
Thumbs.db
Desktop.ini
.DS_Store
